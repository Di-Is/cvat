# syntax=docker/dockerfile:1.7
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl \
        git \
        libglib2.0-0 \
        libgl1 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && mv /root/.local/bin/uvx /usr/local/bin/uvx

COPY cvat-cli /tmp/cvat-cli
COPY cvat-sdk /tmp/cvat-sdk
COPY ai-models/tracker/sam2 /workspace/ai-models/tracker/sam2

ENV PYTHONPATH=/workspace

RUN uv pip install --system -r /workspace/ai-models/tracker/sam2/requirements.txt \
    && uv pip install --system /tmp/cvat-cli \
    && uv pip install --system /tmp/cvat-sdk \
    && rm -rf /tmp/cvat-cli /tmp/cvat-sdk

CMD ["python", "/workspace/ai-models/tracker/sam2/func.py"]
